# Copie este arquivo para .env antes de rodar o app.
# Sem este arquivo o app quebra ao iniciar, de proposito: nao existe
# padrao razoavel para "onde esta o servidor".
#
# Sem barra no final. O app remove automaticamente se você colocar.

# Backend local (com `uv run task dev` na pasta backend/)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Android Emulator + backend na máquina host
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# API publicada no Render (mobile e web)
EXPO_PUBLIC_API_URL=https://campus-cultural-api.onrender.com
